{
  "framework": null,
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "redirects": [
    {
      "source": "/demo",
      "destination": "/#showcase",
      "statusCode": 301
    },
    {
      "source": "/demo/",
      "destination": "/#showcase",
      "statusCode": 301
    },
    {
      "source": "/demo/:path*",
      "destination": "/#showcase",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        }
      ]
    }
  ]
}
