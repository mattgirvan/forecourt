{
  "framework": null,
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "redirects": [
    {
      "source": "/book",
      "destination": "https://cal.com/matthew-girvan-i3mfm7/forecourtkickoff",
      "statusCode": 302
    },
    {
      "source": "/book/",
      "destination": "https://cal.com/matthew-girvan-i3mfm7/forecourtkickoff",
      "statusCode": 302
    },
    {
      "source": "/demo",
      "destination": "/#showcase",
      "statusCode": 301
    },
    {
      "source": "/demo/",
      "destination": "/#showcase",
      "statusCode": 301
    },
    {
      "source": "/demo/:path*",
      "destination": "/#showcase",
      "statusCode": 301
    },
    {
      "source": "/pilot",
      "destination": "/pricing",
      "statusCode": 301
    },
    {
      "source": "/pilot/",
      "destination": "/pricing",
      "statusCode": 301
    },
    {
      "source": "/security",
      "destination": "/trust",
      "statusCode": 301
    },
    {
      "source": "/security/",
      "destination": "/trust",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        }
      ]
    }
  ]
}
